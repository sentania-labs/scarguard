# User-generated config (keep the example, ignore the live copy)
config/scarguard.yml

# Runtime data — snapshots, SQLite database
data/

# Model files — large binaries not tracked in git
models/

# Version file — generated at build time from git tag, not tracked
VERSION

# Docker environment overrides
.env

# One-time migration script (not tracked — only needed for v0.7→v0.8 upgrade)
migrate-to-volumes.sh

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Editors
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# v0.12.7 PoC scratch — bench harness, results, throwaway diagnostics.
# Not shipped to GHCR images; lives only in working tree.
scratch/

# Local PKA comm zone (not shared)
.pka/

# Ad-hoc scratch area (screenshots, throwaway notes)
tmp/

# Claude Code runtime artifacts (scheduled task locks, etc.)
.claude/

# Local training artifacts (datasets, venvs, ultralytics runs)
training/.venv/
training/merged_dataset*/
training/runs/
