# User-generated config (keep the example, ignore the live copy)
config/scarguard.yml

# Runtime data — snapshots, SQLite database
data/

# Model files — large binaries not tracked in git
models/

# Version file — generated at build time from git tag, not tracked
VERSION

# Docker environment overrides
.env

# One-time migration script (not tracked — only needed for v0.7→v0.8 upgrade)
migrate-to-volumes.sh

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Editors
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
