# ScarGuard — Caddy reverse proxy configuration (REFERENCE ONLY)
#
# ⚠️  This file is NOT read at runtime. It exists as a reference for
# what the generated Caddyfile looks like in each TLS mode. The active
# Caddyfile is produced by a Python heredoc inside config/caddy-entrypoint.sh
# — any change intended to affect production Caddy behaviour must be made
# there. (A v0.12.8 attempt to edit this file and nothing else was a
# no-op in production; v0.12.9 fixed it in caddy-entrypoint.sh.)
#
# Three TLS modes are supported:
#   off     — HTTP only (default, for LAN use)
#   auto    — Automatic HTTPS via Let's Encrypt (requires a public domain)
#   manual  — User-provided certificate and key files

# ── Common snippet: security headers + reverse proxy ───────────────────────
(scarguard) {
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://unpkg.com"
		-Server
	}
	# Drop common bot-probe paths at the edge so they never reach FastAPI.
	# 404 (not 403) is intentional — quieter, looks like the path doesn't
	# exist so scanners are less likely to follow up with more probes.
	@probes {
		path /.git/* /_ignition/* /aws*config.js /config.js
	}
	respond @probes 404
	reverse_proxy web:8080
}

# ── Mode: off ──────────────────────────────────────────────────────────────
# Uncomment for plain HTTP (LAN only, no TLS):
#
# :80 {
#     import scarguard
# }

# ── Mode: auto ─────────────────────────────────────────────────────────────
# Uncomment and set your domain for automatic Let's Encrypt HTTPS:
#
# example.com {
#     import scarguard
# }

# ── Mode: manual ───────────────────────────────────────────────────────────
# Uncomment for user-provided certificates:
#
# :443 {
#     tls /config/certs/cert.pem /config/certs/key.pem
#     import scarguard
# }
# :80 {
#     redir https://{host}{uri} permanent
# }
