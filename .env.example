# ScarGuard — Docker Compose Environment Variables
#
# Copy this file to .env and adjust as needed.
# The setup.sh script does this automatically.
#
#   cp .env.example .env

# ── Image source ────────────────────────────────────────────────────────────
# GitHub organization or user that owns the GHCR packages.
# Only change this if you forked the repo and publish your own images.
GHCR_OWNER=sentania-labs

# Image tag to pull.
# - "latest"  → always pull the most recent build from main (default)
# - "v1.2.3"  → pin to a specific release for stability
IMAGE_TAG=latest

# ── Detector platform (auto-set by setup.sh) ──────────────────────────────
# Jetson/L4T:    ghcr.io/sentania-labs/scarguard-detector
# x86 (CUDA+CPU): ghcr.io/sentania-labs/scarguard-detector-x86
DETECTOR_IMAGE=ghcr.io/sentania-labs/scarguard-detector

# Compose files — GPU override adds runtime: nvidia to the detector.
# GPU:       docker-compose.yml:docker-compose.gpu.yml
# CPU-only:  docker-compose.yml
COMPOSE_FILE=docker-compose.yml

# ── Redis authentication ──────────────────────────────────────────────────
# IMPORTANT: Do not leave empty in production.  setup.sh auto-generates a
# strong random password on first run.  If you're creating .env manually,
# generate one: head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32
REDIS_PASSWORD=

# ── Detection event signing (v1.14+) ──────────────────────────────────────
# HMAC-SHA256 key used by detector, deterrent, and notifier to
# authenticate detection events on the internal Redis bus.  Prevents a
# compromised sidecar from injecting fake detections and triggering
# physical actuation.  setup.sh generates this automatically.  If you're
# creating .env manually, generate one with:
#   head -c 32 /dev/urandom | base64
# To rotate: regenerate, restart all services (detector + deterrent +
# notifier must agree on the current key).
DETECTION_HMAC_KEY=

# ── Training lifecycle controller authentication ─────────────────────────
# Dedicated credential shared only by trainer and training-controller. It
# protects the narrowly allowlisted detector stop/restart API. setup.sh
# generates this automatically; for manual setup use:
#   head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32
TRAINING_CONTROLLER_TOKEN=

# ── Reverse proxy (Caddy) ──────────────────────────────────────────────────
# External ports served by Caddy.  TLS mode is configured in scarguard.yml
# (Settings > TLS in the web UI), not here.
HTTP_PORT=80
HTTPS_PORT=443

# Internal web-service port (no host binding by default — Caddy proxies to it).
# Only change this if you uncomment the web service's ports: mapping for debugging.
WEB_PORT=8080
