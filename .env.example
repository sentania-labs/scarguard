# ScarGuard — Docker Compose Environment Variables
#
# Copy this file to .env and adjust as needed.
# The setup.sh script does this automatically.
#
#   cp .env.example .env

# ── Image source ────────────────────────────────────────────────────────────
# GitHub organization or user that owns the GHCR packages.
# Only change this if you forked the repo and publish your own images.
GHCR_OWNER=sentania-labs

# Image tag to pull.
# - "latest"  → always pull the most recent build from main (default)
# - "v1.2.3"  → pin to a specific release for stability
IMAGE_TAG=latest

# ── Web UI ──────────────────────────────────────────────────────────────────
# Host port for the web interface. Change if 8080 is already in use on your Orin.
WEB_PORT=8080
